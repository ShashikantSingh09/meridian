{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The island window. Everything else goes through the app's own commands.",
  "windows": ["island"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
